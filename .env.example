# ---- Supabase (public; safe in the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://jxobukpkbefhgyzncrfo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_5CuAJz6KZ5hijwrHnuKs9Q_vFqDn87s

# ---- Supabase (server only; copy from Supabase → Project Settings → API → service_role) ----
SUPABASE_SERVICE_ROLE_KEY=

# ---- The safe (vault). 64 hex characters. Generate with: pnpm vault keygen ----
VAULT_KEY=

# Emergency fallback: comma-separated admin emails used when the vault can't be opened.
# Normally leave blank and keep admins inside the vault.
ADMIN_EMAILS=

# ---- Where the site lives (used for auth redirects and Stripe return URLs) ----
NEXT_PUBLIC_SITE_URL=https://grandmas-truck-lot.vercel.app

# ---- Payments (optional). Leave blank to run in simulated "test mode". ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ---- Optional ----
# Protects the daily cleanup cron (/api/cron/expire). Any long random string; Vercel sends it as a Bearer token.
CRON_SECRET=

# ---- Local development without Supabase: everything in memory, resets on restart ----
# LOT_STORE=memory
# Signs the pretend sign-in cookie in memory mode only. Any string.
# DEV_AUTH_SECRET=
